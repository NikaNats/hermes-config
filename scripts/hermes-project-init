#!/usr/bin/env bash
# Bootstrap a project with agent-safety conventions (spec 6.2).
# Usage: hermes-project-init <project-name>
# Creates ~/src/<name> + ~/agent/workspaces/<name>, git init, .agentignore.
set -Eeuo pipefail
IFS=$'\n\t'

PROJECT_NAME="${1:?Usage: hermes-project-init <project-name>}"

# Strict allow-list for project names (blocks basename/.. traversal and
# shell injection via slashes, spaces, or metacharacters)
if [[ ! "$PROJECT_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
    echo "FATAL: Invalid project name '$PROJECT_NAME'. Must start with alphanumeric and contain only [a-zA-Z0-9._-]" >&2
    exit 1
fi

ROOT="$HOME/src/$PROJECT_NAME"
WORKSPACE="$HOME/agent/workspaces/$PROJECT_NAME"

mkdir -p "$ROOT" "$WORKSPACE"
cd "$ROOT"

if [[ ! -d .git ]]; then
    git init
fi

# Safe .agentignore generation (no variable interpolation risks)
cat > .agentignore <<'EOF'
.git/
node_modules/
.venv/
venv/
dist/
build/
target/
.next/
coverage/
*.log
.env
.env.*
*.pem
*.p12
*.pfx
*.key
EOF

# Git-level ignore (mirrors .agentignore secret patterns).
# Git reads .gitignore, NOT .agentignore — without this, `git add .`
# stages secrets in every new project.
cat > .gitignore <<'GITEOF'
# Dependencies / build artifacts
node_modules/
.venv/
venv/
dist/
build/
target/
.next/
coverage/

# Secrets (mirrors .agentignore — spec 5.6)
.env
.env.*
*.pem
*.p12
*.pfx
*.key
id_rsa
id_ed25519
.aws/
.azure/
.config/gcloud/
.ssh/
.gnupg/

# Logs
*.log

# Agent index (CodeGraph)
.codegraph/
GITEOF

git add .agentignore .gitignore 2>/dev/null || true
git commit -m "chore(safety): add .agentignore and .gitignore" 2>/dev/null \
    || echo "note: nothing to commit or git identity not configured"
echo "Project initialized at $ROOT"
